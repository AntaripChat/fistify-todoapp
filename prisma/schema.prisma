

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id  String @id @default(uuid())
  name String
  email String @unique
  phone String
  password String
  isAdmin Boolean @default(false)
  createAt DateTime @default(now())
  todo Todo[]
}


model Todo{
  id String @id @default(uuid())
  title String
  createAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id])
}